# Do NOT put credentials into source control. Supply actual values via secret manager.
SCU_MODE=production
SCU_PUBLIC_URL=https://campus.example.edu
SCU_TRUST_PROXY=explicit
SCU_OIDC_ISSUER=https://sso.example.edu/realms/campus
SCU_OIDC_CLIENT_ID=campus-web
SCU_OIDC_CLIENT_SECRET=REPLACE_USING_SECRET_MANAGER
SCU_OIDC_ROLE_CLAIM=campus_role
SCU_MFA_ACR_VALUES=REPLACE_WITH_INSTITUTION_MFA_ACR
SCU_REQUIRE_MFA=true
SCU_CSRF_SECRET=REPLACE_WITH_LONG_RANDOM_32_PLUS_CHARACTER_SECRET
SCU_SIS_WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_SHARED_SECRET
SCU_SIS_OUTBOUND_URL=https://sis.example.edu/integration/campus-events
SCU_DB=/var/lib/campus-os/campus.sqlite3
PORT=8765
